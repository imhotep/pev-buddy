# Settings for deploy/deploy.sh. Copy to .env (git-ignored) and fill in:
#   cp .env.sample .env

# SSH destination: a hostname, IP, or a Host alias from ~/.ssh/config.
DEPLOY_HOST=pev-buddy.example.com
# SSH user; leave empty to use the one from ~/.ssh/config.
DEPLOY_USER=ubuntu
DEPLOY_SSH_PORT=22

# The app's checkout on the server, relative to the user's home (or absolute).
DEPLOY_APP_DIR=pev-buddy
# What to deploy by default: a branch, tag or commit (--ref overrides it).
DEPLOY_REF=main
# The systemd unit that runs uvicorn, and the port it listens on (localhost).
DEPLOY_SERVICE=pev-buddy
DEPLOY_APP_PORT=8765
# Public URL, to check the live site serves the new build (leave empty to skip).
DEPLOY_PUBLIC_URL=https://pev-buddy.example.com

# Local data bundle to upload (built with `python -m pev_buddy.sync`).
DEPLOY_DATA_DIR=data
# Data snapshots kept on the server for --rollback.
DEPLOY_KEEP_BACKUPS=3
